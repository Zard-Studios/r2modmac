<Project Sdk="Microsoft.NET.Sdk">
  <!-- STRAFTAT matchmaking marker (see ../README.md). Loaded by the shim only in games that ship
       ComputerysModdingUtilities.dll; neither reference is copied into the build. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>AppleSiliconMods.Straftat</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ComputerysModdingUtilities/**" />
    <ProjectReference Include="ComputerysModdingUtilities/ComputerysModdingUtilities.csproj" Private="false" />
    <ProjectReference Include="../AppleSiliconMods/AppleSiliconMods.csproj" Private="false" />
  </ItemGroup>
</Project>
